<?xml version="1.0" encoding="utf-8"?>
<!-- GÉNÉRÉ par tool/generate_brand.py (spec 007) : ne pas modifier à la main. -->
<resources>
    <!-- Fenêtre pendant le démarrage du processus, jusqu'au premier rendu de Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12 et plus : écran de lancement du système, fond surface (spec 001, CA29), logo au centre (spec 007, CA3). -->
        <item name="android:windowSplashScreenBackground">@color/tidemark_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <!-- Fenêtre derrière l'interface de Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tidemark_surface</item>
    </style>
</resources>
