<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de l'app dans les sauvegardes ni les transferts d'appareil
     (Android 12 et plus) : ADR-002, spec 001 (CA25). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
